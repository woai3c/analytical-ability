# ── 服务地址（一般不用改）──────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# 正式部署时填写 Web 来源，例如 https://example.com；本地 localhost 自动允许。
WEB_ORIGIN=
# 只有这个地址会进入浏览器包；任何 API Key 都不要使用 VITE_ 前缀。
VITE_API_BASE_URL=http://127.0.0.1:8787

# ── 模型供应商：配了哪个 Key 就用哪个，只需一个 ─────────────────────
# 月之暗面 Kimi（国内 platform.moonshot.cn；国际站需另设 MOONSHOT_BASE_URL=https://api.moonshot.ai/v1）
MOONSHOT_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# 阿里云百炼 / 通义千问
ALIBABA_API_KEY=
# 智谱 GLM
ZHIPU_API_KEY=
# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# xAI Grok
XAI_API_KEY=
# 自定义 OpenAI 兼容服务（三个都填才生效）
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ── 可选覆盖 ──────────────────────────────────────────────────────
# 显式指定模型，格式 "provider:model"，如 moonshotai:kimi-k3。
# 不配时自动使用第一个已配置 Key 的供应商默认模型。
LLM_MODEL=
MOONSHOT_BASE_URL=
LLM_TIMEOUT_MS=90000
