# 服务地址
HOST=127.0.0.1
PORT=8787
# 正式部署时填写 Web 来源，例如 https://example.com；本地 localhost 自动允许。
WEB_ORIGIN=
# 只有这个地址会进入浏览器包；任何 API Key 都不要使用 VITE_ 前缀。
VITE_API_BASE_URL=http://127.0.0.1:8787

# 当前启用：openai | anthropic | deepseek | qwen | kimi | glm | doubao | ernie | custom
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=90000
LLM_MAX_OUTPUT_TOKENS=4000

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼 / 通义千问
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 月之暗面 / Kimi（模型名以控制台当前可用列表为准）
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# 智谱 / GLM（模型名以控制台当前可用列表为准）
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=

# 火山方舟 / 豆包（模型通常填写推理接入点 ID）
ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# 百度千帆 / 文心（QIANFAN_API_KEY 填 V2 Bearer Token）
QIANFAN_API_KEY=
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
ERNIE_MODEL=

# 自定义 OpenAI Chat Completions 兼容服务
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
